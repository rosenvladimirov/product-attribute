<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='general_information']" position="after">
                <page string="Manufacturer data" name="manufacturer_data" invisible="product_variant_count &gt; 1">
                    <separator string="Manufacturer"/>
                    <field name="manufacturer_ids"
                            colspan="2"
                            nolabel="1"
                            context="{'default_product_tmpl_id': id, 'default_company_id': company_id}"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
