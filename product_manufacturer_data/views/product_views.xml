<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_variant_easy_edit_manufacturer_view" model="ir.ui.view">
        <field name="name">product.product.manufacturer.common.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Manufacturers &amp; Datasheets" name="manufacturer">
                    <separator string="Manufacturers"/>
                    <field name="manufacturer_ids" context="{'search_default_product_tmpl_id': active_id, 'search_default_product_id': False, 'default_product_id': False, 'default_product_tmpl_id': active_id}">
                        <list editable="bottom">
                            <field name="manufacturer"/>
                            <field name="product_id" invisible="1"/>
                            <field name="product_tmpl_id" string="Product" invisible="1"/>
                            <field name="manufacturer_pref"/>
                            <field name="manufacturer_pname"/>
                            <field name="manufacturer_purl" widget="url"/>
                        </list>
                    </field>
<!--                    <separator string="Datasheets"/>-->
<!--                    <field name="datasheet_ids" mode="kanban"/>-->
                </group>
            </xpath>
        </field>
    </record>
</odoo>
