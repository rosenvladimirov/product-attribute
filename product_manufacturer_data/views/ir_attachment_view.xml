    <record id="view_product_manufacturer_datasheets_eazy_tree" model="ir.ui.view">
        <field name="name">product.manufacturer.datasheets.tree</field>
        <field name="model">product.manufacturer.datasheets</field>
        <field eval="1" name="priority"/>
        <field name="arch" type="xml">
            <list string="Product Manufacturer">
                <field name="iso_number"/>
                <field name="date_issue"/>
                <field name="date_expiry"/>
                <field name="qc_manager_id"/>
                <field name="name" />
                <!-- <field name="datas_fname"/> -->
                <field name="manufacturer_id"/>
                <field name="product_brand_id"/>
                <field name="version"/>
            </list>
        </field>
    </record>

    <record id="view_datasheets_form" model="ir.ui.view">
        <field name="name">product.manufacturer.datasheets.form</field>
        <field name="model">product.manufacturer.datasheets</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <form string="Attachments">
                <sheet>
                    <label for="name" class="oe_edit_only"/>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                           <field name="res_id" invisible="1"/>
                            <field name="type"/>
                            <field name="datas" filename="datas_fname" invisible="type == 'url'"/>
                            <field name="url" widget="url" invisible="type == 'binary'"/>
                            <field name="mimetype" groups="base.group_no_one"/>
                            <field name="is_date"/>
                        </group>
                        <group>
                            <field name="manufacturer_id" domain="[('product_tmpl_id.product_variant_ids', 'in', [res_id])]"/>
                            <field name="manufacturer_ids" widget="many2many_tags" invisible="context.get('hide_manufacturer')" domain="[('manufacturer_id', '=', context.get('partner_id'))]"/>
                            <field name="manufacturer_id"/>
                            <field name="version"/>
                        </group>
                        <group string="Attached To" groups="base.group_no_one">
                            <field name="res_model"/>
                            <field name="res_field"/>
                            <field name="res_id"/>
                            <field name="res_name"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="public"/>
                        </group>
                    </group>
                    <group name="iso" string="Certificate data">
                        <group>
                            <field name="iso_number"/>
                            <field name="date_issue"/>
                            <!-- <field name="notified_body_ids" widget="many2many_tags"/> -->
                        </group>
                        <group>
                            <field name="qc_manager_id"/>
                            <field name="date_expiry" invisible="not is_date"/>
                            <field name="notified_body_id" context="{'type_company': 1}"/>
                        </group>
                    </group>
                    <group name="description_group" string="Description" groups="base.group_no_one" colspan="4">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="History" groups="base.group_no_one" colspan="4">
                        <label for="create_uid" string="Creation"/>
                        <div name="creation_div">
                            <field name="create_uid" readonly="1" class="oe_inline"/> on
                            <field name="create_date" readonly="1" class="oe_inline"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
