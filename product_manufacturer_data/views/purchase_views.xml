<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_buttons" model="ir.ui.view">
        <field name="name">purchase.order.form.buttons</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='product_id']" position="after">
                <field
                    name="manufacturer_id"
                    readonly="state in ['purchase', 'to approve','done', 'cancel']"
                    context="{'default_product_id': product_id, 'supplierinfo_ids': parent.partner_id}"
                />
            </xpath>
            <xpath expr="//group/field[@name='product_id']" position="after">
                <field
                    name="manufacturer_id"
                    context="{'default_product_id': product_id, 'supplierinfo_ids': parent.partner_id}"
                />
            </xpath>
        </field>
    </record>
</odoo>
