<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_manufacturer_form_view" model="ir.ui.view">
            <field name="name">product.manufacturer.form.view</field>
            <field name="model">product.manufacturer</field>
            <field name="arch" type="xml">
                <form string="Manufacturer Information">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        </div>
                        <field name="active" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <group>
                            <group colspan="4" string="Manufacturer" name="manufacturer">
                                <group>
                                    <field name="product_tmpl_id"
                                           string="Product"
                                           invisible="context.get('visible_product_tmpl_id', True)"/>
                                    <field name="product_id" domain="[('product_tmpl_id', '=', product_tmpl_id)]" options="{'no_create_edit': True}"/>
                                    <field name="product_variant_id" invisible="1"/>
                                    <field name="company_id" groups="base.group_multi_company"
                                        options="{'no_create': True}"/>
                                </group>
                                <group>
                                    <field name="manufacturer" context="{'default_customer': 0, 'search_default_supplier': 1, 'default_supplier': 1}"/>
                                    <field name="manufacturer_pname"/>
                                    <field name="manufacturer_pref"/>
                                    <field name="manufacturer_purl" widget="url"/>
                                </group>
                            </group>
                            <group colspan="2" string="Distributors" name="supplierinfo">
<!--                                <field name="supplierinfo_ids"-->
<!--                                       nolabel="1"-->
<!--                                       colspan="2"-->
<!--                                       context="{'search_default_product_tmpl_id': product_tmpl_id, 'default_product_tmpl_id': product_tmpl_id, 'default_product_id': product_id}"-->
<!--                                />-->
                                <field name="supplierinfo_ids"
                                       nolabel="1"
                                       colspan="2"
                                       mode="list"
                                       context="{'search_default_product_tmpl_id': product_tmpl_id, 'default_product_tmpl_id': product_tmpl_id, 'default_product_id': product_id}">
                                    <list string="Distributors" editable="bottom">
                                        <field name="company_id" column_invisible="1"/>
                                        <field name="manufacturer_id" column_invisible="1"/>
                                        <field name="product_id" column_invisible="1"/>
                                        <field name="product_tmpl_id" string="Product" column_invisible="1"/>
                                        <field name="company_id" groups="!base.group_multi_company" column_invisible="1"/>
                                        <field name="product_code"/>
                                        <field name="product_name"/>
                                        <field name="min_qty"/>
                                        <field name="price" string="Price"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                                    </list>
                                </field>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_manufacturer_search_view" model="ir.ui.view">
            <field name="name">product.manufacturer.search.view</field>
            <field name="model">product.manufacturer</field>
            <field name="arch" type="xml">
                <search string="Manufacturer">
                    <field string="Manufacturer" name="manufacturer" filter_domain="[('manufacturer', '=', self)]"/>
                    <field string="Company" name="company_id" filter_domain="[('company_id', '=', self)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Product" name="groupby_product" domain="[]" context="{'group_by': 'product_tmpl_id'}"/>
                        <filter string="Manufacturer" name="groupby_manufacturer" domain="[]" context="{'group_by': 'manufacturer'}"/>
                        <filter string="Company" name="groupby_company" domain="[]" context="{'group_by': 'company_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="product_manufacturer_list_view" model="ir.ui.view">
            <field name="name">product.manufacturer.list.view</field>
            <field name="model">product.manufacturer</field>
            <field name="arch" type="xml">
                <list string="Manufacturer Information">
                    <field name="manufacturer"/>
                    <field name="product_id" column_invisible="context.get('product_template_invisible_variant', False)" groups="product.group_product_variant"/>
                    <field name="product_tmpl_id" string="Product" column_invisible="context.get('visible_product_tmpl_id', True)"/>
                    <field name="company_id" groups="!base.group_multi_company" column_invisible="1"/>
                    <field name="manufacturer_pref"/>
                    <field name="manufacturer_pname"/>
                    <field name="manufacturer_purl"/>
                    <field name="supplierinfo_ids" widget="many2many_tags"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="product_manufacturer_action" model="ir.actions.act_window">
            <field name="name">Product manufacturer</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.manufacturer</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'visible_product_tmpl_id':False}</field>
        </record>

        <menuitem
           action="product_manufacturer_action" id="menu_product_manufacturer_purchase"
                parent="purchase.menu_procurement_management" sequence="17"/>
    </data>
</odoo>
