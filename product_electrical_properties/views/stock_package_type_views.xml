<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_package_type_form_inherit_eia481" model="ir.ui.view">
        <field name="name">stock.package.type.form.inherit.eia481</field>
        <field name="model">stock.package.type</field>
        <field name="inherit_id" ref="stock.stock_package_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="EIA-481 Specifications" name="eia481_specs">
                        <group>
                            <group string="Package Information">
                                <field name="package_identifier"/>
                                <field name="quantity_code" widget="selection"/>
                                <field name="components_per_reel"/>
                                <field name="dimensions"/>
                                <field name="reel_diameter"/>
                            </group>
                            <group string="Component Layout">
                                <field name="component_orientation"/>
                                <field name="sprocket_holes"/>
                                <field name="pitch"/>
                                <field name="cavity_dimensions"/>
                            </group>
                        </group>
                        <group>
                            <group string="Tape Specifications">
                                <field name="tape_material"/>
                                <field name="cover_tape_material"/>
                                <field name="cover_tape_width"/>
                                <field name="cover_tape_peel_strength"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_package_type_tree_inherit_eia481" model="ir.ui.view">
        <field name="name">stock.package.type.tree.inherit.eia481</field>
        <field name="model">stock.package.type</field>
        <field name="inherit_id" ref="stock.stock_package_type_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="package_identifier"/>
                <field name="dimensions"/>
                <field name="quantity_code"/>
                <field name="components_per_reel"/>
            </field>
        </field>
    </record>
</odoo>
