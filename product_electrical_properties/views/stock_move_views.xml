<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_operation_tree_inherit_data_code" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.inherit.data_code</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_name" position="after">
                <field name="data_code" string="Data Code" groups="stock.group_production_lot"
                       placeholder="e.g. 2550"
                       column_invisible="parent.has_tracking == 'none'"
                       readonly="package_level_id and parent.picking_type_entire_packs"
                       optional="hide"/>
            </field>
        </field>
    </record>
    <record id="view_stock_move_line_detailed_operation_tree_inherit_data_code" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operations.list.inherit.data_code</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_name" position="after">
                <field name="data_code" string="Data Code" groups="stock.group_production_lot"
                       column_invisible="context.get('picking_code') != 'incoming' or not context.get('show_lots_text')"
                       invisible="not lots_visible"
                       readonly="state in ('done', 'cancel') and is_locked"
                       context="{'default_product_id': product_id}"
                       optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
