<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_form_inherit_data_code" model="ir.ui.view">
        <field name="name">stock.move.line.form.inherit.data_code</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form"/>
        <field name="arch" type="xml">
            <field name="lot_name" position="after">
                <field name="data_code" groups="stock.group_production_lot"
                   invisible="tracking == 'none'"/>
            </field>
        </field>
    </record>
</odoo>
