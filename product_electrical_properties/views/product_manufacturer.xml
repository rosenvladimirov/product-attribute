<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_manufacturer_form_view" model="ir.ui.view">
            <field name="name">product.manufacturer.form.view</field>
            <field name="model">product.manufacturer</field>
            <field name="inherit_id" ref="product_manufacturer_data.product_manufacturer_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='manufacturer']" position="after">
                    <group name="reel_packaging" string="Manufacturer Product Packages" colspan="2" groups="product.group_stock_packaging">
                        <field name="packaging_ids"
                               nolabel="1"
                               colspan="2"
                               mode="list"
                               invisible="not product_variant_id"
                               context="{'list_view_ref':'product.product_packaging_tree_view2', 'default_product_id': product_variant_id}"/>
                        <field name="tmpl_packaging_ids"
                               nolabel="1"
                               colspan="2"
                               mode="list"
                               invisible="product_variant_id"
                               context="{'list_view_ref':'product.product_packaging_tree_view2', 'default_product_id': product_variant_id}"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
