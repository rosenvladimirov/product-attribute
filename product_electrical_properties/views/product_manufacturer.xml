<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_manufacturer_form_view" model="ir.ui.view">
            <field name="name">product.manufacturer.form.view</field>
            <field name="model">product.manufacturer</field>
            <field name="inherit_id" ref="product_manufacturer_data.product_manufacturer_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='manufacturer']" position="after">
                    <group name="reelpackaging" string="Manufacturer Product Packages" colspan="2" groups="product.group_stock_packaging">
                        <field name="reelpackaging_ids"
                               nolabel="1"
                               colspan="2"
                               mode="tree"
                               context="{'tree_view_ref':'product_electrical_properties.product_packaging_reel_tree_view2', 'default_product_id': product_variant_id, 'default_manufacturer_id': active_id}"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
