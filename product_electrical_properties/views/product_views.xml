<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_normal_form_view_inherit_component" model="ir.ui.view">
        <field name="name">product.product.form.inherit.component</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Electrical data" name="component_data" invisible="not is_product_variant">
                    <group>
                        <group string="Storage Requirements">
                            <field name="moisture_sensitivity_level"/>
                            <field name="storage_conditions"/>
                            <field name="esd_protection"/>
                        </group>
                        <group string="Component types">
                            <field name="component_type_id"/>
<!--                            <field name="short_description"/>-->
                            <field name="manufacturer_id" invisible="1"/>
                        </group>
                        <separator string="Technical data" invisible="not component_type_id" colspan="4"/>
                        <div class="d-flex" invisible="not component_type_id" colspan="4">
                            <field name="component_properties"
                                   nolabel="1"
                                   columns="2"
                                   hideKanbanOption="0"
                                   invisible="not component_type_id"/>
                        </div>
                        <group name="manufacturer" string="Manufacturer" colspan="2">
                            <field name="manufacturer_ids"
                                    colspan="2"
                                    nolabel="1"
                                    context="{'default_product_tmpl_id': id, 'default_company_id': company_id}"/>
                        </group>
                        <group name="reel" string="Reels" colspan="2" invisible="not manufacturer_id">
                            <field name="packaging_ids"
                                   colspan="2"
                                   nolabel="1"
                                   readonly="1"
                                   context="{'list_view_ref':'product.product_packaging_tree_view2', 'default_product_id': product_variant_id, 'manufacturer_id': manufacturer_id}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_variant_tree_view_inherit_component" model="ir.ui.view">
        <field name="name">product.product.tree.inherit.component</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="component_type_id"/>
                <field name="moisture_sensitivity_level"/>
                <field name="storage_conditions"/>
            </field>
        </field>
    </record>

    <record id="product_variant_search_view_inherit_component" model="ir.ui.view">
        <field name="name">product.product.search.inherit.component</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="component_type_id"/>
                <field name="moisture_sensitivity_level"/>
                <field name="storage_conditions"/>
                <separator/>
                <filter string="With ESD Protection"
                        name="with_esd"
                        domain="[('esd_protection', '=', True)]"/>
                <filter string="Special Storage Required"
                        name="special_storage"
                        domain="[('storage_conditions', '!=', 'normal')]"/>
                <filter string="High MSL (>3)"
                        name="high_msl"
                        domain="[('moisture_sensitivity_level', 'in', ['4','5','5a','6'])]"/>
            </field>
            <filter name="categ_id" position="after">
                <filter string="Component Type"
                        name="groupby_component"
                        context="{'group_by': 'component_type_id'}"/>
                <filter string="MSL"
                        name="groupby_msl"
                        context="{'group_by': 'moisture_sensitivity_level'}"/>
                <filter string="Storage"
                        name="groupby_storage"
                        context="{'group_by': 'storage_conditions'}"/>
            </filter>
        </field>
    </record>

    <record id="product_kanban_view_inherit_component" model="ir.ui.view">
        <field name="name">product.product.kanban.component</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view"/>
        <field name="arch" type="xml">
            <!-- Добавяме полетата в списъка с полета -->
            <xpath expr="//field[@name='activity_state']" position="after">
                <field name="component_type_id"/>
                <field name="moisture_sensitivity_level"/>
                <field name="esd_protection"/>
            </xpath>

            <!-- Добавяме новата информация след product_template_variant_value_ids -->
            <xpath expr="//field[@name='product_template_variant_value_ids']" position="after">
                <t t-if="record.moisture_sensitivity_level.value">
                    <!-- MSL -->
                    <field name="moisture_sensitivity_level"
                           widget="badge"
                           nolabel="1"
                           decoration-warning="moisture_sensitivity_level in ['3','4']"
                           decoration-danger="moisture_sensitivity_level in ['5','5a','6']"/>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
