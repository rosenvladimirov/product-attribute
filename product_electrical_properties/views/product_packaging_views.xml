<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_packaging_form_view_inherit_eia481" model="ir.ui.view">
        <field name="name">product.packaging.form.inherit.eia481</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_form_view"/>
        <field name="arch" type="xml">
            <!-- Добавяме EIA-481 полетата след основните полета -->
            <xpath expr="//group[@name='qty']" position="after">
                <group name="eia481_package" string="Package Information">
                    <field name="package_identifier"/>
                    <field name="quantity_code"/>
                    <field name="components_per_reel"/>
                    <field name="reel_diameter" invisible="package_identifier != 'R'"/>
                </group>

                <group name="eia481_tape" string="Tape Specifications" invisible="package_identifier == 'B'">
                    <field name="dimensions"/>
                    <field name="pitch"/>
                    <field name="cavity_dimensions"/>
                    <field name="tape_material"/>
                </group>

                <group name="eia481_component" string="Component Layout" invisible="package_identifier == 'B'">
                    <field name="component_orientation"/>
                    <field name="sprocket_holes"/>
                </group>

                <group name="eia481_cover" string="Cover Tape" invisible="package_identifier == 'B'">
                    <field name="cover_tape_material"/>
                    <field name="cover_tape_width"/>
                    <field name="cover_tape_peel_strength"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_packaging_tree_view_inherit_eia481" model="ir.ui.view">
        <field name="name">product.packaging.tree.inherit.eia481</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="package_identifier" optional="show"/>
                <field name="dimensions" optional="hide"/>
                <field name="quantity_code" optional="show"/>
                <field name="components_per_reel" optional="hide"/>
                <field name="reel_diameter" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="product_packaging_search_view_inherit_eia481" model="ir.ui.view">
        <field name="name">product.packaging.search.inherit.eia481</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_search_view"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="package_identifier"/>
                <field name="dimensions"/>
                <field name="quantity_code"/>
                <field name="reel_diameter"/>
                <separator/>
                <filter name="reel_packages" string="Reel Packages" domain="[('package_identifier', '=', 'R')]"/>
                <filter name="tape_packages" string="Tape Packages" domain="[('package_identifier', '=', 'T')]"/>
                <filter name="bulk_packages" string="Bulk Packages" domain="[('package_identifier', '=', 'B')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_package_type" string="Package Type" context="{'group_by': 'package_identifier'}"/>
                    <filter name="group_by_dimensions" string="Tape Width" context="{'group_by': 'dimensions'}"/>
                    <filter name="group_by_quantity" string="Quantity Code" context="{'group_by': 'quantity_code'}"/>
                </group>
            </field>
        </field>
    </record>
</odoo>
