<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_users_form" model="ir.ui.view">
            <field name="name">res.users.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='preferences']" position="after">
                    <group string="Nexar data access">
                        <field name="nexar_client_id"/>
                        <field name="nexar_client_secret"/>
                        <field name="nexar_token" invisible="1"/>
                        <field name="nexar_exp" readonly="1"/>
                    </group>
                </xpath>
            </field>
        </record>
        <record id="view_users_form_simple_modif" model="ir.ui.view">
            <field name="name">res.users.preferences.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='preferences']" position="inside">
                    <group>
                        <field name="nexar_client_id" string="Nexar client id"/>
                        <field name="nexar_client_secret"/>
                        <field name="nexar_token" invisible="1"/>
                        <field name="nexar_exp" readonly="1"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
