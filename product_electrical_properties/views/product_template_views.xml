<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_update_nextar_data"
                        type="object"
                        class="oe_stat_button"
                        string="Octpart"
                        icon="fa-database"/>
            </xpath>
            <xpath expr="//notebook/page[@name='general_information']" position="after">
                <page string="Electrical data" name="project_bom_data" invisible="product_variant_count &gt; 1">
                    <group>
                        <group string="Other data">
<!--                            <field name="short_description"/>-->
                            <field name="component_type_id"/>
                            <field name="manufacturer_id" invisible="1"/>
                        </group>
                        <group name="manufacturer" string="Manufacturer" colspan="2">
                            <field name="manufacturer_ids"
                                    colspan="2"
                                    nolabel="1"
                                    context="{'default_product_tmpl_id': active_id, 'default_company_id': company_id}"/>
                        </group>
                        <group name="reel" string="Reels" colspan="2" invisible="not manufacturer_id">
                            <field name="reelpackaging_ids"
                                   colspan="2"
                                   nolabel="1"
                                   readonly="1"
                                   context="{'tree_view_ref':'product_electrical_properties.product_packaging_reel_tree_view2', 'default_product_id': product_variant_id, 'manufacturer_id': manufacturer_id}"/>
                        </group>
                        <separator string="Technical data" invisible="not component_type_id" colspan="4"/>
                        <div class="d-flex" invisible="not component_type_id" colspan="4">
                            <field name="component_properties"
                                   nolabel="1"
                                   columns="4"
                                   colspan="4"
                                   hideKanbanOption="0"
                                   invisible="not component_type_id"/>
                        </div>>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="product_template_form_manufacturer_data_view" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_manufacturer_data.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='manufacturer_data']" position="replace"/>
        </field>
    </record>
</odoo>
