<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_mbb_opening_wizard_form" model="ir.ui.view">
            <field name="name">mbb.opening.wizard.form</field>
            <field name="model">mbb.opening.wizard</field>
            <field name="arch" type="xml">
                <form string="Confirmation to open MBB">
                    <sheet>
                        <div class="oe_title">
                            <h1>Opening MBB packages</h1>
                            <p>The following batches are in sealed MBB packaging. Tick which packs will be open:</p>
                        </div>
                        <group>
                            <group>
                                <field name="picking_id" invisible="1"/>
                                <field name="move_line_ids" invisible="1"/>
                                <field name="mbb_opening_date"/>
                            </group>
                            <field name="opening_lines" nolabel="1" colspan="2">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="product_id" readonly="1"/>
                                    <field name="lot_id" readonly="1"/>
                                    <field name="qty_done" readonly="1"/>
                                    <field name="current_msl_level" readonly="1"/>
                                    <field name="will_open_mbb"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_confirm" string="Confirm and continue" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
