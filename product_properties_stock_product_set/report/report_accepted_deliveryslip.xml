<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_accepted_delivery_document" inherit_id="l10n_bg_report_stock.report_accepted_delivery_document">
        <xpath expr="//t[@t-set='has_serial_number']" position="after">
            <t t-set="product_set_id" t-value="False"/>
            <t t-set="after_product_set_id" t-value="False"/>
        </xpath>
        <xpath expr="//td[@name='td_product_set']" position="replace">
            <t t-if="line and (o.use_product_properties == 'properties' and line.has_properties)">
                <t t-set="properties_print" t-value="o.print_properties"/>
                <td name="td_name_product_properties">
                    <t t-call="product_properties.product_properties_description"/>
                </td>
            </t>
            <t t-else="">
                <td name="td_product_set" colspan="99">
                    <span t-field="move.product_set_id"/>
                </td>
            </t>
        </xpath>
        <xpath expr="//tr[@name='has_serial_number_line']" position="attributes">
            <attribute name="t-if" add="move_line.show_details" separator=" "/>
        </xpath>
        <xpath expr="//tr[@name='has_serial_number_line']" position="before">
            <tr t-if="move_line.move_id.product_set_id and move_line.move_id.product_set_id != product_set_id">
                <t t-set="product_set_id" t-value="move_line.move_id.product_set_id"/>
                <t t-if="o.use_product_properties == 'properties'">
                    <t t-set="properties_print" t-value="o.print_properties"/>
                    <td name="td_name_product_properties" colspan="2">
                        <t t-set="properties_print" t-value="o.print_properties"/>
                        <t t-if="has_serial_number">
                            <t t-set="lot_ids" t-value="move_line"/>
                        </t>
                        <t t-set="old_line" t-value="move_line"/>
                        <t t-set="line" t-value="move_line"/>
                        <t t-set="product_properties" t-value="move_line.move_id.product_set_id"/>
                        <t name="td_name_product_properties" t-call="product_properties.product_properties_description"/>
                        <t t-set="line" t-value="old_line"/>
                    </td>
                </t>
                <t t-else="">
                    <td name="td_product_set" colspan="2" class="active">
                        <span>&amp;bull;</span> <span t-field="move_line.move_id.product_set_id"/>
                    </td>
                </t>
                <td name="td_product_set_quantity" class="active text-right">
                    <span t-esc="move_line._get_product_set()[0].quantity"/>
                </td>
            </tr>
        </xpath>
<!--        <xpath expr="//tr[@name='has_serial_number_line']" position="after">-->
<!--            <tr t-if="move_line.move_id.product_set_id and move_line.move_id.product_set_id != after_product_set_id and move_line.show_details">-->
<!--                <t t-set="after_product_set_id" t-value="move_line.move_id.product_set_id"/>-->
<!--                <td class="text-right" colspan="2">-->
<!--                    <span>Total:</span>-->
<!--                </td>-->
<!--                <td>-->
<!--                    <span t-esc="move_line._get_product_set()[1]"/>-->
<!--                </td>-->
<!--            </tr>-->
<!--        </xpath>-->
    </template>

    <template id="stock_report_delivery_aggregated_move_lines" inherit_id="stock_picking_product_set.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//tr[@name='tr_aggregated_move_lines']" position="before">
            <tr t-if="aggregated_lines[line].get('product_set_ids') and product_set_id != aggregated_lines[line].get('product_set_ids')">
                <t t-set="product_set_id" t-value="aggregated_lines[line].get('product_set_ids')"/>
                <t t-if="line and (o.use_product_properties == 'properties'and line.has_properties)">
                    <t t-set="properties_print" t-value="o.print_properties"/>
                    <td name="td_name_product_properties" colspan="2" class="active">
                        <t t-call="product_properties.product_properties_description"/>
                    </td>
                </t>
                <t t-else="">
                    <td name="td_product_set" colspan="2" class="active">
                        <span>&amp;bull;</span> <span t-field="product_set_id['name']"/>
                    </td>
                </t>
                <td name="td_product_set_quantity" class="active text-right">
                    <span t-esc="aggregated_lines[line]['qty_set']"/>
                </td>
            </tr>
        </xpath>
    </template>

    <!-- product_set related "section lines" -->
    <template id="stock_report_accepted_delivery_product_set_section_line">
        <tr t-att-class="'bg-200 fw-bold o_line_section'">
            <td colspan="99" name="product_set_info">
                <span>&amp;bull;</span> <span>Uncategorized</span><span t-field="product_set.name"/>
            </td>
        </tr>
    </template>
</odoo>
