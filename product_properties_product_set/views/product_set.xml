<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_set_form" model="ir.ui.view">
        <field name="name">product.set.form</field>
        <field name="model">product.set</field>
        <field name="inherit_id" ref="product_set.view_product_set_form"/>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='set_pricelist_ids']" position="after">
                <notebook>
                    <page name="product_properties" string="Product properties">
                        <group name="buttons" col="2" groups="base.group_no_one">
                            <button name="auto_correct_static" type="object" icon="fa-handshake-o" string="Auto" title="Auto" class="oe_link" groups="base.group_no_one"/>
                            <button name="view_static_properties" type="object" icon="fa-bars" string="View" title="View static properties" class="oe_link" groups="base.group_no_one"/>
                        </group>
                        <group name="info" invisible="0" groups="base.group_no_one">
                            <field name="has_product_properties" invisible="1" groups="base.group_no_one"/>
                            <field name="count_static_properties" invisible="0" groups="base.group_no_one"/>
                        </group>
                        <group name="product_properties" string="Technical access" groups="base.group_no_one">
                            <group name="system" invisible="0" colspan="4" groups="base.group_no_one">
                                <label for="product_prop_static_id" string="Properties Category" col="1" groups="base.group_no_one"/>
                                <field name="product_prop_static_id" invisible="0" nolabel="1" col="3" groups="base.group_no_one"/>
                            </group>
                        </group>
                        <group name="dynamic_categories" colspan="4" string="Categories">
                            <label for="properties_category_ids" string="Properties Category" col="1"/>
                            <field name="properties_category_ids" nolabel="1" widget="many2many_tags" col="3" options="{'no_create_edit': True}"/>
                        </group>
                        <separator string="Dynamic"/>
                        <field name="product_properties_ids" context="{'default_product_tmpl_id': active_id, 'search_default_product_tmpl_id': active_id}">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="product_id" invisible="1"/>
                                <field name="name"/>
                                <field name="type_display"/>
                                <field name="categ_id" invisible="1"/>
                                <field name="type_fields" invisible="1"/>
                                <field name="type_field_model_id" invisible="1"/>
                                <field name="type_field_target" invisible="1"/>
                                <field name="type_char" invisible="1"/>
                                <field name="type_int" invisible="1"/>
                                <field name="type_int_second" invisible="1"/>
                                <field name="type_package_id" invisible="1"/>
                                <field name="type_float" invisible="1"/>
                                <field name="type_boolean" invisible="1"/>
                                <field name="dimensions_x" invisible="1"/>
                                <field name="dimensions_y" invisible="1"/>
                                <field name="dimensions_z" invisible="1"/>
                                <field name="type_uom_id" invisible="1"/>
                                <field
                                    name="type_url"
                                    widget="image_url"
                                    class="oe_image_small"
                                    width="100px"
                                    height="100px"
                                    invisible="type_fields != 'url'"
                                />
                                <field name="type_display_attrs" invisible="1"/>
                            </list>
                        </field>
                        <group name="dynamic_properties" colspan="4" string="In categories">
                            <label for="curr_category_ids" string="Properties Category" col="1"/>
                            <field name="curr_category_ids" col="3" nolabel="1" widget="many2many_tags"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
