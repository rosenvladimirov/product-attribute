<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field eval="12" name="priority"/>
        <field name="arch" type="xml">
             <xpath expr="//div[@name='button_box']" position="inside">
                <field name="use_product_set" invisible="1"/>
                <button name="toggle_use_product_set"
                        type="object" icon="fa-eye"
                        title="Toggle between expand and collapse"
                        class="oe_stat_button">
                    <span invisible="use_product_set != 'reset'">All open</span>
                    <span invisible="use_product_set != 'closed'">All close</span>
                    <span invisible="use_product_set != 'manual'">Manual</span>
                    <span invisible="use_product_set != 'expand'">Expand</span>
                    <span invisible="use_product_set != 'collapse'">Collapse</span>
                </button>
             </xpath>
        </field>
    </record>
</odoo>
