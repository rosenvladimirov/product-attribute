<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_properties_tree_view" model="ir.ui.view">
        <field name="name">product.properties.view</field>
        <field name="model">product.properties</field>
        <field name="inherit_id" ref="product_properties.product_properties_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_set_id"/>
            </xpath>
        </field>
    </record>
</odoo>
