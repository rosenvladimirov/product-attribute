<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_buttons" model="ir.ui.view">
        <field name="name">account.move.form.buttons</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="use_product_set" invisible="1"/>
                <button
                    name="toggle_use_product_set"
                    type="object"
                    icon="fa-eye"
                    title="Toggle between expand and collapse"
                    class="oe_stat_button"
                    invisible="not product_set_ids"
                >
                    <span invisible="use_product_set != 'reset'">All open</span>
                    <span invisible="use_product_set != 'closed'">All close</span>
                    <span invisible="use_product_set != 'manual'">Manual</span>
                    <span invisible="use_product_set != 'expand'">Expand</span>
                    <span invisible="use_product_set != 'collapse'">Collapse</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
