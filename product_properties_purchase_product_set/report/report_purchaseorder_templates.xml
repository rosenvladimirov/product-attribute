<?xml version="1.0"?>
<odoo>
    <template id="report_purchase_order_html" inherit_id="product_properties.report_purchase_order_html">
        <xpath expr="//td[@name='td_section_line']" position="replace">
            <t t-if="o.use_product_properties == 'properties' and o.print_properties and line.product_set_id">
                <td name="td_section_line">
                    <t t-set="properties_print" t-value="o.print_properties"/>
                    <t t-set="product_properties" t-value="line.product_set_id"/>
                    <t t-call="product_properties.product_properties_description"/>
                </td>
            </t>
            <t t-else="">
                <td name="td_section_line" t-att-colspan="'99' if o.use_product_properties != 'properties' else ''">
                    <span>&amp;bull;</span> <span t-field="line.name"/>
                </td>
            </t>
        </xpath>
        <xpath expr="//td[@name='td_section_quantity']" position="replace">
            <td name="td_section_quantity_properties" class="text-end">
                <span t-field="line.product_set_qty"/>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_section_priceunit']" position="replace">
            <td name="td_section_line_quantity" class="text-end">
                <span t-esc="line.product_set_price_subtotal/(line.product_set_qty != 0.0 and line.product_set_qty or 1.0)" t-options='{"widget": "float", "decimal_precision": "Product Price"}'/>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_section_subtotal']" position="replace">
            <td name="td_section_subtotal_properties" class="text-end">
                <span t-field="line.product_set_price_subtotal" t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
            </td>
        </xpath>
    </template>
    <template id="report_purchaseorder_document_hide_detail" inherit_id="purchase_layout_category_hide_detail.report_purchaseorder_document_hide_detail">
<!--        <xpath expr="//t[@t-set='display_table_head']" position="replace">-->
<!--            <t t-set="display_table_head" t-value="not any(l.show_details or l.product_set_id for l in o.order_line.filtered(lambda r: r.display_type == 'line_section')) or any(l.show_details or l.product_set_id for l in o.order_line.filtered(lambda r: r.display_type == 'line_section'))"/>-->
<!--        </xpath>-->
        <xpath expr="//td[@name='current_section_name']" position="replace">
<!--            <td name="td_numero_section">-->
<!--                <span t-esc="current_section_index"/>-->
<!--            </td>-->
            <t t-if="o.use_product_properties == 'properties' and o.print_properties and line.product_set_id">
                <t name="colspan_calculate_prduct_set" t-set="colspan" t-value="colspan-3"/>
                <td name="current_section_name" t-att-colspan="colspan">
                    <t t-set="properties_print" t-value="o.print_properties"/>
                    <t t-set="product_properties" t-value="current_section.product_set_id"/>
                    <t t-call="product_properties.product_properties_description"/>
                </td>
            </t>
            <t t-else="">
                <t t-if="line.product_set_id" name="colspan_calculate_product_set_no" t-set="colspan" t-value="colspan-3"/>
                <td name="current_section_name" t-att-colspan="colspan">
                    <span t-field="current_section.name" class="fw-bold float-start"/>
                </td>
            </t>
        </xpath>
        <xpath expr="//td[@name='current_section_current_subtotal']" position="replace">
            <t t-if="o.use_product_properties == 'properties' and o.print_properties and line.product_set_id">
                <td name="td_section_quantity_properties" class="text-end">
                    <span t-field="current_section.product_set_qty"
                          t-if="current_section.show_section_subtotal"/>
                </td>
                <td name="td_section_line_quantity" class="text-end">
                    <span t-esc="current_section.product_set_price_subtotal/(current_section.product_set_qty != 0.0 and current_section.product_set_qty or 1.0)"
                          t-if="current_section.show_section_subtotal"
                          t-options='{"widget": "float", "decimal_precision": "Product Price"}'/>
                </td>
                <td><span t-esc="', '.join(current_section.get_print_taxes())"/></td>
                <td name="td_section_subtotal_properties" class="text-end">
                    <span t-if="current_section.show_section_subtotal"
                          t-field="current_section.product_set_price_subtotal"
                          t-options='{"widget": "monetary", "display_currency": current_section.currency_id}'/>
                </td>
            </t>
            <t t-else="">
                <t t-if="line.product_set_id">
                    <td><span t-esc="', '.join(current_section.get_print_taxes())"/></td>
                    <td name="date_planned"/>
                    <td name="td_section_quantity_properties" class="text-end">
                        <span t-field="current_section.product_set_qty"
                              t-if="current_section.show_section_subtotal"/>
                    </td>
                    <td name="td_section_line_quantity" class="text-end">
                        <span t-esc="current_section.product_set_price_subtotal/(current_section.product_set_qty != 0.0 and current_section.product_set_qty or 1.0)"
                              t-if="current_section.show_section_subtotal"
                              t-options='{"widget": "float", "decimal_precision": "Product Price"}'/>
                    </td>
                    <td/>
                    <td name="td_section_subtotal_properties" class="text-end">
                        <span t-if="current_section.show_section_subtotal"
                              t-field="current_section.product_set_price_subtotal"
                              t-options='{"widget": "monetary", "display_currency": current_section.currency_id}'/>
                    </td>
                </t>
                <t t-else="">
                    <td class="text-end">
                        <span t-if="current_section.show_section_subtotal"
                              t-esc="current_subtotal"
                              t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                    </td>
                </t>
            </t>
        </xpath>
    </template>
