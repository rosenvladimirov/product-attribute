<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="properties_fields.PropertiesDefinitionViewer">
        <div class="o_list_view o_view_controller o_properties_definition_list">
            <!-- Control Panel -->
            <div class="o_control_panel d-flex align-items-center justify-content-between">
                <div class="o_control_panel_main_buttons d-flex">
                    <button class="btn btn-primary o_list_button_add"
                            t-att-disabled="props.readonly"
                            title="Add Property">
                        <i class="fa fa-plus me-1"/>
                        Add Property
                    </button>
                </div>
                <div class="o_control_panel_breadcrumbs">
                    <div class="o_control_panel_breadcrumbs_actions">
                        <span class="o_pager">
                            <span class="o_pager_counter">
                                <span class="o_pager_value" t-esc="propertiesData.length"/>
                                / <span class="o_pager_limit" t-esc="propertiesData.length"/>
                            </span>
                        </span>
                    </div>
                </div>
            </div>

            <!-- List Content -->
            <div class="o_content">
                <div class="o_list_renderer">
                    <div class="o_list_table_wrapper">
                        <table class="o_list_table table table-sm table-hover o_list_table_ungrouped">
                            <thead>
                                <tr class="o_list_header_columns">
                                    <!-- Selection checkbox -->
                                    <th class="o_list_record_selector" width="1">
                                        <div class="o_list_record_selector_wrapper">
                                            <input type="checkbox" class="form-check-input o_list_record_selector_all"/>
                                        </div>
                                    </th>

                                    <!-- Name Column -->
                                    <th class="o_column_sortable"
                                        data-name="name"
                                        tabindex="-1">
                                        <span class="d-flex align-items-center">
                                            <span>Name</span>
                                            <i class="fa fa-sort text-muted ms-1"/>
                                        </span>
                                    </th>

                                    <!-- String Column -->
                                    <th class="o_column_sortable"
                                        data-name="string"
                                        tabindex="-1">
                                        <span class="d-flex align-items-center">
                                            <span>Label</span>
                                            <i class="fa fa-sort text-muted ms-1"/>
                                        </span>
                                    </th>

                                    <!-- Type Column -->
                                    <th class="o_column_sortable"
                                        data-name="type"
                                        tabindex="-1">
                                        <span class="d-flex align-items-center">
                                            <span>Type</span>
                                            <i class="fa fa-sort text-muted ms-1"/>
                                        </span>
                                    </th>

                                    <!-- Model Column -->
                                    <th data-name="comodel">Model</th>

                                    <!-- Default Column -->
                                    <th data-name="default">Default</th>

                                    <!-- View in Cards Column -->
                                    <th data-name="view_in_cards" width="1">
                                        <span class="o_column_title">Cards</span>
                                    </th>

                                    <!-- Printable Column -->
                                    <th data-name="printable" width="1">
                                        <span class="o_column_title">Printable</span>
                                    </th>

                                    <!-- Actions Column -->
                                    <th class="o_list_actions_header" width="1">
                                        <span>Actions</span>
                                    </th>
                                </tr>
                            </thead>

                            <tbody class="ui-sortable">
                                <t t-foreach="propertiesData" t-as="property" t-key="property.name">
                                    <tr class="o_data_row o_list_row_multiselect"
                                        t-att-data-id="property.name"
                                        t-on-click="() => this.onRowClick(property)"
                                        t-att-class="{ 'o_selected_row': state.selectedRows.has(property.name) }">

                                        <!-- Selection checkbox -->
                                        <td class="o_list_record_selector" t-on-click.stop="">
                                            <div class="o_list_record_selector_wrapper">
                                                <input type="checkbox"
                                                       class="form-check-input o_list_record_selector"
                                                       t-att-checked="state.selectedRows.has(property.name)"
                                                       t-on-change="(ev) => this.onRowSelect(property.name, ev)"/>
                                            </div>
                                        </td>

                                        <!-- Name Cell -->
                                        <td class="o_data_cell cursor-pointer"
                                            data-field="name"
                                            t-on-click="() => this.onCellClick(property, 'name')">
                                            <span class="o_field_widget o_field_char">
                                                <code class="o_field_text text-monospace small" t-esc="property.name"/>
                                            </span>
                                        </td>

                                        <!-- String Cell -->
                                        <td class="o_data_cell cursor-pointer"
                                            data-field="string"
                                            t-on-click="() => this.onCellClick(property, 'string')">
                                            <span class="o_field_widget o_field_char">
                                                <strong class="o_field_text" t-esc="property.string"/>
                                            </span>
                                        </td>

                                        <!-- Type Cell -->
                                        <td class="o_data_cell cursor-pointer"
                                            data-field="type"
                                            t-on-click="() => this.onCellClick(property, 'type')">
                                            <div class="o_field_widget o_field_selection d-flex align-items-center">
                                                <img class="o_field_property_type_icon me-2"
                                                     t-attf-src="{{ getTypeIcon(property.type) }}"
                                                     t-attf-alt="{{ property.type }}"
                                                     style="width: 16px; height: 16px;"
                                                     onerror="this.style.display='none'"/>
                                                <span class="badge text-bg-secondary" t-esc="property.type"/>
                                            </div>
                                        </td>

                                        <!-- Comodel Cell -->
                                        <td class="o_data_cell cursor-pointer"
                                            data-field="comodel"
                                            t-on-click="() => this.onCellClick(property, 'comodel')">
                                            <span t-if="property.comodel" class="o_field_widget o_field_char">
                                                <span class="o_field_text text-muted small" t-esc="property.comodel"/>
                                            </span>
                                        </td>

                                        <!-- Default Cell -->
                                        <td class="o_data_cell cursor-pointer"
                                            data-field="default"
                                            t-on-click="() => this.onCellClick(property, 'default')">
                                            <span t-if="property.default" class="o_field_widget o_field_text">
                                                <span class="o_field_text text-truncate d-inline-block"
                                                      style="max-width: 150px;"
                                                      t-esc="property.default"
                                                      t-att-title="property.default"/>
                                            </span>
                                        </td>

                                        <!-- View in Cards Cell -->
                                        <td class="o_data_cell" data-field="view_in_cards" t-on-click.stop="">
                                            <div class="o_field_widget o_field_boolean">
                                                <div class="o_checkbox">
                                                    <input type="checkbox"
                                                           class="form-check-input"
                                                           t-att-checked="property.view_in_cards"
                                                           disabled="disabled"/>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Printable Cell -->
                                        <td class="o_data_cell" data-field="printable" t-on-click.stop="">
                                            <div class="o_field_widget o_field_boolean">
                                                <div class="o_checkbox">
                                                    <input type="checkbox"
                                                           class="form-check-input o_printable_checkbox"
                                                           t-att-checked="property.printable"
                                                           t-att-disabled="props.readonly"
                                                           t-on-change="(ev) => this.onPrintableToggle(property, ev)"
                                                           t-att-title="props.readonly ? 'Read only' : 'Mark as printable'"/>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Actions Cell -->
                                        <td class="o_data_cell o_list_record_actions" t-on-click.stop="">
                                            <div class="dropdown">
                                                <button class="btn btn-link btn-sm dropdown-toggle o_dropdown_toggler_btn"
                                                        type="button"
                                                        data-bs-toggle="dropdown"
                                                        t-att-disabled="props.readonly">
                                                    <i class="fa fa-ellipsis-v"/>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li>
                                                        <button class="dropdown-item o_list_button_edit"
                                                                t-on-click="() => this.onEditProperty(property)"
                                                                t-att-disabled="props.readonly">
                                                            <i class="fa fa-pencil me-2"/>
                                                            Edit
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item o_list_button_duplicate"
                                                                t-on-click="() => this.onDuplicateProperty(property)"
                                                                t-att-disabled="props.readonly">
                                                            <i class="fa fa-copy me-2"/>
                                                            Duplicate
                                                        </button>
                                                    </li>
                                                    <li><hr class="dropdown-divider"/></li>
                                                    <li>
                                                        <button class="dropdown-item text-danger o_list_button_delete"
                                                                t-on-click="() => this.onDeleteProperty(property)"
                                                                t-att-disabled="props.readonly">
                                                            <i class="fa fa-trash me-2"/>
                                                            Delete
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                </t>

                                <!-- No content row -->
                                <tr t-if="!propertiesData.length" class="o_data_row">
                                    <td colspan="9" class="o_data_cell">
                                        <div class="o_view_nocontent">
                                            <div class="o_nocontent_help">
                                                <img class="o_nocontent_empty_folder"
                                                     src="/web/static/img/empty_folder.svg"
                                                     alt="Empty"/>
                                                <div class="o_nocontent_title">
                                                    No properties configured
                                                </div>
                                                <p class="o_nocontent_subtitle">
                                                    Create your first property to get started
                                                </p>
                                                <div t-if="!props.readonly">
                                                    <button class="btn btn-primary o_nocontent_cta"
                                                            t-on-click="() => this.onAddProperty()">
                                                        <i class="fa fa-plus me-1"/>
                                                        Add a property
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
