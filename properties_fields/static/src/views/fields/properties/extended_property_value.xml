<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.PropertyValue" t-inherit="web.PropertyValue" t-inherit-mode="extension">
        <!-- Модифицираме readonly условието -->
        <xpath expr="//t[contains(@t-if, 'readonly')]" position="replace">
            <t t-if="props.readonly and !['boolean', 'many2one', 'many2many', 'tags', 'fields'].includes(props.type || (props.definition and props.definition.type))">
                <span t-if="displayValue" t-out="displayValue"/>
            </t>
        </xpath>

        <xpath expr="//CheckBox/.." position="after">
            <t t-elif="(props.type || (props.definition and props.definition.type)) === 'fields'">
                <!-- Input поле (readonly) -->
                <input
                    class="o_input"
                    t-att-id="props.id"
                    type="text"
                    autocomplete="off"
                    readonly="readonly"
                    disabled="disabled"
                    t-att-value="displayValue || ''"
                    t-att-placeholder="props.string ? ('Field: ' + props.string) : 'There is no field selected'"
                />
            </t>
        </xpath>
    </t>
</templates>
