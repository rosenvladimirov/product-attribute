<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_definition_fix_wizard_form" model="ir.ui.view">
        <field name="name">property.definition.fix.wizard.form</field>
        <field name="model">property.definition.fix.wizard</field>
        <field name="arch" type="xml">
            <form string="Fix Property Definitions">
                <sheet>
                    <p></p>
                    <group>
                        <field name="property_definition_id" widget="property_definition_viewer" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Apply"
                            name="action_apply"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_property_definition_fix_wizard" model="ir.actions.act_window">
        <field name="name">Fix Property Definitions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">property.definition.fix.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_category"/>
        <field name="binding_view_types">form</field>
        <field name="context">{'default_property_definition_id': product_properties_definition}</field>
    </record>
</odoo>
