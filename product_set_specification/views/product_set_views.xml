<?xml version="1.0"?>
<odoo>
    <record id="view_product_set_form" model="ir.ui.view">
        <field name="name">product.set.form.specifications</field>
        <field name="model">product.set</field>
        <field name="inherit_id" ref="product_set.view_product_set_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='set_line_ids']" position="before">
                <group colspan="4">
                    <label for="specifications" col="1"/>
                    <field col="3" name="specifications" nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_product_set_specification_tree" model="ir.ui.view">
        <field name="name">product.set.tree</field>
        <field name="model">product.set</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="ref"/>
                <field name="display_name"/>
                <field name="specifications"/>
            </list>
        </field>
    </record>
    <record id="specification_product_set_search_view" model="ir.ui.view">
        <field name="name">specifications.product.set.search</field>
        <field name="model">product.set</field>
        <field name="arch" type="xml">
            <search string="Specification">
                <field name="specifications" filter_domain="[('specifications', 'like', raw_value)]"/>
                <filter name="is_specifications" string="Available Specifications" domain="[('specifications','!=',False)]"/>
            </search>
        </field>
    </record>
    <record id="specification_product_set_action" model="ir.actions.act_window">
        <field name="name">Product Specification</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.set</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_product_set_specification_tree"/>
        <field name="search_view_id" ref="specification_product_set_search_view"/>
        <field name="context">{'search_default_is_specifications': 1}</field>
    </record>

    <menuitem id="specification_product_set_menu" name="Product Set" action="specification_product_set_action"
        parent="product_specifications.product_specification_menu" sequence="3"/>

</odoo>
