<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_pricelist_fixed_price.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pricelist_item_ids']/list/field[@name='pricelist_id']" position="after">
                <field name="product_set_id"/>
            </xpath>
            <xpath expr="//field[@name='variant_pricelist_item_ids']/list/field[@name='pricelist_id']" position="after">
                <field name="product_set_id"/>
            </xpath>
        </field>
    </record>
    <record id="product_variant_easy_edit_view" model="ir.ui.view">
        <field name="name">product.product.view.form.properties.easy</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product_pricelist_fixed_price.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pricelist_item_ids']/list/field[@name='pricelist_id']" position="after">
                <field name="product_set_id"/>
            </xpath>
        </field>
    </record>
</odoo>
