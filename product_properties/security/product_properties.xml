<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_product_properties" model="ir.module.category">
            <field name="name">Product properties</field>
            <field name="description">Helps you manage your Product Properties.</field>
            <field name="sequence">10</field>
        </record>
        <record id="product_properties.group_properties_user" model="res.groups">
            <field name="name">Properties User</field>
            <field name="category_id" ref="module_category_product_properties"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">The Product Properties user uses to fill data in product</field>
        </record>
        <record id="product_properties.group_properties_manager" model="res.groups">
            <field name="name">Properties Manager</field>
            <field name="category_id" ref="module_category_product_properties"/>
            <field name="implied_ids" eval="[(4, ref('product_properties.group_properties_user'))]"/>
            <field name="comment">The Product Properties manager manages to configure new types</field>
        </record>
        <record id="stock.group_stock_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('product_properties.group_properties_user'))]"/>
        </record>
        <record model="res.groups" id="stock.group_stock_manager">
           <field name="implied_ids" eval="[(4,ref('product_properties.group_properties_manager'))]"/>
        </record>
        <record model="res.users" id="base.user_root">
           <field name="groups_id" eval="[(4,ref('product_properties.group_properties_manager'))]"/>
        </record>
    </data>
</odoo>