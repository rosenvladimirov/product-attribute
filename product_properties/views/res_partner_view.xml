<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <page name="sales_purchases" position="after">
                <page string="Printing properties" name="print_prop" colspan="4" attrs="{'invisible': [('is_company','=',False),('parent_id','!=',False)]}">
                    <group string="Default configuration for printing">
                        <group col="2" name="technical_button">
                            <button name="set_all_print_properties"
                                    string="Load" type="object"
                                    class="oe_highlight"/>
                            <button name="remove_all_print_properties"
                                string="Clear" type="object"
                                class="oe_highlight"/>
                        </group>
                        <group col="2" name="technical">
                            <button name="remove_all_print_properties"
                                    string="Remove" type="object"
                                    class="oe_highlight"/>
                        </group>
                    </group>
                    <field name="print_properties" context="{'default_partner_id': active_id}">
                        <form string="Printing properties">
                            <sheet>
                                <group>
                                    <field name="name"/>
                                    <field name="static_field"/>
                                    <field name="print"/>
                                </group>
                            </sheet>
                        </form>
                        <list string="Printing properties">
                            <field name="name"/>
                            <field name="static_field"/>
                            <field name="print"/>
                            <field name="partner_id" invisible="1"/>
                        </list>
                    </field>
                </page>
                <page string="Printing properties" name="print_properties_parent" attrs="{'invisible': ['|',('is_company','=',True),('parent_id','=',False)]}">
                    <div>
                        <p>Printing properties-related settings are managed on <button name="open_commercial_entity" type="object" string="the parent company" class="oe_link"/></p>
                    </div>
                </page>
            </page>
        </field>
    </record>
</odoo>
