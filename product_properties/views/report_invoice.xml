<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_account_move_html">
        <t t-call="product_properties.internal_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)" />
            <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
            <table class="table table-sm o_main_table table-borderless" name="invoice_line_table">
                <thead>
                    <tr>
                        <th name="th_description" class="text-start"><span>Description</span></th>
                        <th name="th_quantity" class="text-end"><span>Quantity</span></th>
                        <th name="th_priceunit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Unit Price</span></th>
                        <th name="th_price_unit" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span>Disc.%</span>
                        </th>
                        <th name="th_taxes" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>
                        <th name="th_subtotal" class="text-end">
                            <span>Amount</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="invoice_tbody">
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                    <t t-foreach="lines" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" t-if="o.company_price_include == 'tax_excluded'"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" t-if="o.company_price_include == 'tax_included'"/>

                        <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                <t t-if="line and (o.use_product_properties == 'properties' and line.has_properties)">
                                    <t t-set="properties_print" t-value="o.print_properties"/>
                                    <t t-set="product_properties" t-value="line.product_id"/>
                                    <td name="td_name_product_properties">
                                        <t t-call="product_properties.product_properties_description"/>
                                    </td>
                                </t>
                                <t t-else="">
                                    <td name="td_name">
                                        <span t-field="line.name"/>
                                    </td>
                                </t>
                                <td class="text-end">
                                    <span t-field="line.product_set_qty"/>
                                    <span t-field="line.product_uom_id"  groups="uom.group_uom"/>
                                </td>
                                <td t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span class="text-nowrap" t-field="line.price_unit"/>
                                </td>
                                <td t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span class="text-nowrap" t-field="line.discount"/>
                                </td>
                                <td t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span t-esc="', '.join(map(lambda x: (x.description or x.name), line.tax_ids))" id="line_tax_ids"/>
                                </td>
                                <td class="text-end o_price_total">
                                    <span class="text-nowrap" t-field="line.price_subtotal" t-if="o.company_price_include == 'tax_excluded'"/>
                                    <span class="text-nowrap" t-field="line.price_total" t-if="o.company_price_include == 'tax_included'"/>
                                </td>
                            </t>
                            <t t-if="line.display_type == 'line_section'">
                                <td name="td_section_line" colspan="99">
                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99">
                                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                </td>
                            </t>
                        </tr>
                    </t>
                </tbody>
            </table>
        </t>
    </template>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-set='forced_vat']" position="after">
            <t t-set="invoice_sub_type" t-value="o.invoice_sub_type.name"/>
        </xpath>
        <xpath expr="//t[@t-set='current_subtotal']" position="after">
            <t t-set="current_index" t-value="0"/>
            <t t-set="current_section_index" t-value="1"/>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_description" style="width:5%;" class="text-start">&amp;#8470;</th>
        </xpath>
        <xpath expr="//t[@t-foreach='lines']/t[@t-set='current_subtotal']" position="before">
            <t t-set="current_index" t-value="0" t-if="line.display_type in ['line_section', 'line_note']"/>
            <t t-set="current_index" t-value="current_index+1" t-if="line.display_type in ['product', False]"/>
            <t t-set="current_section_index" t-value="current_section_index+1" t-if="line.display_type in ['line_section', 'line_note']"/>
        </xpath>
        <xpath expr="//tr//t[@name='account_invoice_line_accountable']" position="before">
            <td name="td_numero_section" t-if="line.display_type in ['line_section', 'line_note']">
                <span t-esc="current_section_index"/>
            </td>
            <td name="td_numero" t-if="line.display_type not in ['line_section', 'line_note']">
                <span t-esc="current_section_index"/><span>.</span><span t-esc="current_index"/>
            </td>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="replace">
            <t name="properties_description" t-if="line and (o.use_product_properties == 'properties' and line.has_properties)">
                <t t-set="properties_print" t-value="o.print_properties"/>
                <t t-set="product_properties" t-value="line.product_id"/>
                <td name="td_name_product_properties">
                    <t t-call="product_properties.product_properties_description"/>
                </td>
            </t>
            <t name="properties_description_else" t-else="">
                <td name="properties_account_invoice_line_name">
                    <span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}">Bacon Burger</span>
                </td>
            </t>
        </xpath>
    </template>
</odoo>
