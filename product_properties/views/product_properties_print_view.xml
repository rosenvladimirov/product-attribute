<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Properties for print vies -->
    <record id="product_properties_print_list_view" model="ir.ui.view">
        <field name="name">product.properties.print.list.view</field>
        <field name="model">product.properties.print</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="sale_id"/>
                <field name="picking_id"/>
                <field name="purchase_id"/>
                <field name="partner_id"/>
                <field name="print"/>
                <field name="system_properties"/>
                <field name="static_field"/>
            </list>
        </field>
    </record>
    <record id="product_properties_print_search_view" model="ir.ui.view">
        <field name="name">product.properties.print.search.view</field>
        <field name="model">product.properties.print</field>
        <field name="arch" type="xml">
            <search string="Product properties for print">
                <field string="Properties type" name="name" filter_domain="[('name', '=', self)]"/>
                <group expand="0" string="Group By">
                    <filter string="Partner properties" name="groupby_partner_id" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter string="Sale order properties" name="groupby_sale_id" domain="[]" context="{'group_by': 'sale_id'}"/>
                    <filter string="Invoice properties" name="groupby_invoice_id" domain="[]" context="{'group_by': 'invoice_id'}"/>
                    <filter string="Purchase properties" name="groupby_purchase_id" domain="[]" context="{'group_by': 'purchase_id'}"/>
                    <filter string="Picking properties" name="groupby_picking_id" domain="[]" context="{'group_by': 'picking_id'}"/>
                    <filter string="Static properties" name="groupby_static_field" domain="[]" context="{'group_by': 'static_field'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="product_properties_print_form_view" model="ir.ui.view">
        <field name="name">product.properties.print.form.view</field>
        <field name="model">product.properties.print</field>
        <field name="arch" type="xml">
            <form string="Properties for print">
                <group>
                    <group>
                        <field name="name"/>
                        <field name="print"/>
                        <field name="system_properties"/>
                        <field name="static_field"/>
                    </group>
                </group>
            </form>
        </field>
    </record>
    <record id="product_properties_print_action" model="ir.actions.act_window">
        <field name="name">For print</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.properties.print</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="product_properties_print_search_view"/>
    </record>
</odoo>
