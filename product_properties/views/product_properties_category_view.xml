<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- product.properties.category -->
    <record id="product_properties_category_list_view" model="ir.ui.view">
        <field name="name">product.properties.category.view</field>
        <field name="model">product.properties.category</field>
        <field name="arch" type="xml">
            <list string="Product properties">
                <field name="name"/>
                <field name="applicability"/>
            </list>
        </field>
    </record>
    <record id="product_properties_category_form_view" model="ir.ui.view">
        <field name="name">product.properties.category.form.view</field>
        <field name="model">product.properties.category</field>
        <field name="arch" type="xml">
            <form string="Properties for print">
                <sheet>
                    <group>
                        <group colspan="2">
                            <field name="name"/>
                        </group>
                        <group colspan="2">
                            <field name="applicability" string="Used for"/>
                        </group>
                        <field name="lines_ids" nolabel="1" colspan="4">
                            <list string="Product properties">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
<!--                                <field name="type_display"/>-->
<!--                                <field name="type_display_attrs"/>-->
                                <field name="type_fields" column_invisible="1"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="product_properties_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.properties.category</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="product_properties.product_properties_category_list_view"/>
<!--        <field name="search_view_id" ref="product_properties_category_form_view"/>-->
    </record>

    <!-- product.properties.category.lines -->
    <record id="product_properties_category_lines_search_view" model="ir.ui.view">
        <field name="name">product.properties.category.lines.search.view</field>
        <field name="model">product.properties.category.lines</field>
        <field name="arch" type="xml">
            <search string="Product properties">
                <field string="Internal category" name="product_categ_id" filter_domain="[('product_categ_id', '=', self)]"/>
                <group expand="0" string="Group By">
                    <filter string="Internal category" name="groupby_product_categ_id" domain="[]" context="{'group_by': 'product_categ_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="product_properties_category_lines_list_view" model="ir.ui.view">
        <field name="name">product.properties.category.lines.view</field>
        <field name="model">product.properties.category.lines</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
<!--                <field name="type_display"/>-->
                <!-- <field name="type_range"/> -->
<!--                <field name="type_display_attrs"/>-->
                <field name="type_fields" column_invisible="1"/>
                <field name="image_1920" widget="image" options="{'preview_image': 'image_128'}" column_invisible="type_fields != 'package'"/>
            </list>
        </field>
    </record>
    <record id="product_properties_category_lines_form_view" model="ir.ui.view">
        <field name="name">product.properties.category.lines.form.view</field>
        <field name="model">product.properties.category.lines</field>
        <field name="arch" type="xml">
            <form string="Product properties">
                <sheet>
                    <field name="image_1920" widget="image" options="{'preview_image': 'image_128'}" invisible="type_fields != 'package'"/>
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" string="Properties Name"/>
                        <h1>
                            <field name="name" colspan="4"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="type_fields" readonly="0"/>
                        </group>
                        <group name="properties">
                            <label for="type_currency" invisible="type_fields != 'currency'"/>
                            <div invisible="type_fields != 'currency'">
                                <field name="type_currency" invisible="type_fields != 'currency'"/>
                                <field name="currency_id" invisible="type_fields != 'currency'"/>
                            </div>
                            <field name="type_float" invisible="type_fields != 'float'"/>
                            <field name="type_char" invisible="type_fields != 'char'"/>
                            <field name="type_int" invisible="type_fields != 'int'"/>
                            <field name="type_boolean" invisible="type_fields != 'boolean'"/>
                            <field name="type_url" widget="url" invisible="type_fields != 'url'"/>
                            <field name="type_uom_id" invisible="type_fields not in ('float', 'int', 'dropdown_id')" domain="[('name_id', '=', active_id)]" context="{'default_name_id': active_id}"/>
                            <field name="type_dropdown_id" invisible="type_fields != 'dropdown_id'" domain="[('name_id', '=', active_id)]" context="{'default_name_id': active_id}"/>
                            <field name="type_field" invisible="type_fields != 'field'"/>
                        </group>
                        <group name="fields" string="Fields sources" invisible="type_fields != 'field'">
                            <field name="type_field_model_id" readonly="0" options="{'no_create_edit': True}" invisible="type_fields != 'field'"/>
                            <field name="type_field_target"
                                   options="{'no_create_edit': True}"
                                   invisible="type_fields != 'field'"
                                   domain="[('model_id', '=', type_field_model_id), ('ttype', 'in', ('char', 'monetary', 'float', 'many2one'))]"
                            />
                        </group>
                        <group string="Range" invisible="type_fields != 'range'">
                            <field name="type_int" invisible="type_fields not in ('int', 'range')"/>
                            <field name="type_int_second" invisible="type_fields not in ('int', 'range')"/>
                        </group>
                        <group string="Dimensions" invisible="type_fields != 'package'">
                            <field name="type_package_id" invisible="type_fields != 'package'" domain="[('name_id', '=', active_id)]" context="{'default_name_id': active_id}"/>
                            <field name="dimensions_x"/>
                            <field name="dimensions_y"/>
                            <field name="dimensions_z"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
