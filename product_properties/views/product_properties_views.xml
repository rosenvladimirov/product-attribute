<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- product.properties.package -->
    <record id="product_properties_package_list_view" model="ir.ui.view">
        <field name="name">product.properties.package.list.view</field>
        <field name="model">product.properties.package</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="dimensions_x"/>
                <field name="dimensions_y"/>
                <field name="dimensions_z"/>
                <field name="image_1920" widget="image" options="{'preview_image': 'image_128'}"/>
            </list>
        </field>
    </record>
    <record id="product_properties_package_form_view" model="ir.ui.view">
        <field name="name">product.properties.package.form.view</field>
        <field name="model">product.properties.package</field>
        <field name="arch" type="xml">
            <form string="Package-Corpus">
                <sheet>
                    <field name="image_1920" widget="image" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" string="Package Name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Dimensions">
                            <field name="dimensions_x"/>
                            <field name="dimensions_y"/>
                            <field name="dimensions_z"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="product_properties_package_search_view" model="ir.ui.view">
        <field name="name">product.properties.package.search.view</field>
        <field name="model">product.properties.package</field>
        <field name="arch" type="xml">
            <search string="Product properties package">
                <field string="Name" name="name" filter_domain="[('name', '=', self)]"/>
                <group expand="0" string="Group By">
                    <filter string="Name" name="groupby_name" domain="[]" context="{'group_by': 'name'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="product_properties_package_action" model="ir.actions.act_window">
        <field name="name">Product properties packages</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.properties.package</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="product_properties_package_search_view"/>
    </record>

    <!-- product.properties.static.dropdown -->
    <record id="product_properties_dropdown_list_view" model="ir.ui.view">
        <field name="name">product.properties.dropdown.list.view</field>
        <field name="model">product.properties.dropdown</field>
        <field name="arch" type="xml">
            <list string="Product properties Dropdown">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="product_properties_dropdown_view" model="ir.ui.view">
        <field name="name">product.properties.dropdown.form.view</field>
        <field name="model">product.properties.dropdown</field>
        <field name="arch" type="xml">
            <form string="Product properties Dropdown">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="name_id" domain="[('type_fields', '=', 'dropdown_id')]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="product_properties_dropdown_search_view" model="ir.ui.view">
        <field name="name">product.properties.dropdown.search.view</field>
        <field name="model">product.properties.dropdown</field>
        <field name="arch" type="xml">
            <search string="Product properties Dropdown">
                <field string="Name" name="name" filter_domain="[('name', '=', self)]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="groupby_name_id" domain="[]" context="{'group_by': 'name_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="product_properties_dropdown_action" model="ir.actions.act_window">
        <field name="name">Product properties dropdown</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.properties.dropdown</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="product_properties_dropdown_search_view"/>
    </record>

    <!-- product.properties -->
    <record id="product_properties_search_view" model="ir.ui.view">
        <field name="name">product.properties.search.view</field>
        <field name="model">product.properties</field>
        <field name="arch" type="xml">
            <search string="Product properties">
                <field string="Product" name="product_id" filter_domain="[('product_id', '=', self)]"/>
                <group expand="0" string="Group By">
                    <filter string="Product" name="groupby_product" domain="[]" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="product_properties_list_view" model="ir.ui.view">
        <field name="name">product.properties.view</field>
        <field name="model">product.properties</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="product_tmpl_id"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="name"/>
                <field name="type_display"/>
                <field name="type_display_attrs" column_invisible="type_fields != 'package'"/>
                <field name="type_fields" column_invisible="1"/>
                <field name="image_1920" widget="image" options="{'preview_image': 'image_128'}" column_invisible="type_fields != 'package'"/>
            </list>
        </field>
    </record>
    <record id="product_properties_form_view" model="ir.ui.view">
        <field name="name">product.properties.form.view</field>
        <field name="model">product.properties</field>
        <field name="arch" type="xml">
            <form string="Product properties">
                <sheet>
                    <field name="image_1920" widget="image" options="{'preview_image': 'image_128'}" invisible="type_fields != 'package'"/>
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" string="Properties Name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <h2>
                            <field name="product_id" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="type_fields"/>
                        </group>
                        <group name="properties">
                            <label for="type_currency" invisible="type_fields != 'currency'"/>
                            <div invisible="type_fields != 'currency'">
                                <field name="type_currency" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}" invisible="type_fields != 'currency'"/>
                            </div>
                            <field name="type_float" invisible="type_fields != 'float'"/>
                            <field name="type_char" invisible="type_fields != 'char'"/>
                            <field name="type_int" invisible="type_fields != 'int'"/>
                            <field name="type_boolean" invisible="type_fields != 'boolean'"/>
                            <field name="type_url" widget="url" invisible="type_fields != 'url'"/>
                            <field name="type_dropdown_id" invisible="type_fields != 'dropdown_id'" domain="[('name_id', '=', name)]" context="{'default_name_id': name}"/>
                            <field name="type_uom_id" invisible="type_fields != 'package'" domain="[('name_id', '=', active_id)]" context="{'default_name_id': active_id}"/>
                            <field name="type_field" invisible="type_fields != 'field'"/>
                        </group>
                        <group name="fields" string="Fields sources" invisible="type_fields != 'field'">
                            <field name="type_field_model_id" readonly="0" options="{'no_create_edit': True}" invisible="type_fields != 'field'"/>
                            <field name="type_field_target"
                                   options="{'no_create_edit': True}"
                                   invisible="type_fields != 'field'"
                                   domain="[('model_id', '=', type_field_model_id), ('ttype', 'in', ('char', 'monetary', 'float', 'many2one'))]"
                            />
                        </group>
                        <group string="Range" invisible="type_fields != 'range'">
                            <field name="type_int" invisible="type_fields not in ('int', 'range')"/>
                            <field name="type_int_second" invisible="type_fields not in ('int', 'range')"/>
                        </group>
                        <group string="Dimensions" invisible="type_fields != 'package'">
                            <field name="type_package_id" invisible="type_fields != 'package'" domain="[('name_id', '=', active_id)]" context="{'default_name_id': active_id}"/>
                            <field name="dimensions_x"/>
                            <field name="dimensions_y"/>
                            <field name="dimensions_z"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="product_properties_action" model="ir.actions.act_window">
        <field name="name">Product properties</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.properties</field>
        <!-- <field name="view_type">form</field> -->
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="product_properties_search_view"/>
        <field name="context">{'groupby_product':1}</field>
    </record>
</odoo>
