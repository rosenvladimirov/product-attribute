<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_variant_easy_edit_view" model="ir.ui.view">
        <field name="name">product.product.view.form.properties.easy</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="product_prop_static_id" invisible="1"/>
                <field name="tmpl_product_prop_static_id" invisible="1"/>
                <field name="has_product_properties" invisible="1"/>

                <group name="dynamic_categories" colspan="4" string="Categories">
                        <label for="properties_category_ids" string="Properties Category" col="1"/>
                        <field name="properties_category_ids" nolabel="1" widget="many2many_tags" col="3" options="{'no_create_edit': True}"/>
                </group>
                <group string="Dynamic" name="dynamic_properties">
                    <field name="product_properties_ids" context="{'default_product_tmpl_id': id, 'search_default_product_tmpl_id': id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id" invisible="1"/>
                            <field name="name"/>
                            <field name="type_display"/>
                            <field name="categ_id" invisible="1"/>
                            <field name="type_fields" invisible="1"/>
                            <field name="type_field_model_id" invisible="1"/>
                            <field name="type_field_target" invisible="1"/>
                            <field name="type_char" invisible="1"/>
                            <field name="type_int" invisible="1"/>
                            <field name="type_int_second" invisible="1"/>
                            <field name="type_package_id" invisible="1"/>
                            <field name="type_float" invisible="1"/>
                            <field name="type_boolean" invisible="1"/>
                            <field name="dimensions_x" invisible="1"/>
                            <field name="dimensions_y" invisible="1"/>
                            <field name="dimensions_z" invisible="1"/>
                            <field name="type_uom_id" invisible="1"/>
                            <field name="type_url" widget="image_url" class="oe_image_small" width="100px" height="100px" invisible="type_fields != 'url'"/>
                            <field name="type_display_attrs" invisible="1"/>
<!--                                <field name="image_small" widget="image" attrs="{'invisible':[('type_fields', '!=', 'package')]}" invisible="1"/>-->
<!--                                <field name="image_medium" widget="image" attrs="{'invisible':[('type_fields', '!=', 'package')]}" invisible="1"/>-->
<!--                                <field name="images" widget="image" attrs="{'invisible':[('type_fields', '!=', 'package')]}" invisible="1"/>-->
                        </list>
                    </field>
                </group>
                <group name="dynamic_categories" colspan="4" string="Template Categories">
                        <label for="tmpl_properties_category_ids" string="Template Properties Category" col="1"/>
                        <field name="tmpl_properties_category_ids" nolabel="1" widget="many2many_tags" col="3" readonly="1" options="{'no_create_edit': True}"/>
                </group>
                <group string="Dynamic template" name="dynamic_properties_template">
                    <field name="tmpl_product_properties_ids" readonly="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id" invisible="1"/>
                            <field name="name"/>
                            <field name="type_display"/>
                            <field name="categ_id" invisible="1"/>
                            <field name="type_fields" invisible="1"/>
                            <field name="type_field_model_id" invisible="1"/>
                            <field name="type_field_target" invisible="1"/>
                            <field name="type_char" invisible="1"/>
                            <field name="type_int" invisible="1"/>
                            <field name="type_int_second" invisible="1"/>
                            <field name="type_package_id" invisible="1"/>
                            <field name="type_float" invisible="1"/>
                            <field name="type_boolean" invisible="1"/>
                            <field name="dimensions_x" invisible="1"/>
                            <field name="dimensions_y" invisible="1"/>
                            <field name="dimensions_z" invisible="1"/>
                            <field name="type_uom_id" invisible="1"/>
                            <field name="type_url" widget="image_url" class="oe_image_small" width="100px" height="100px" invisible="type_fields != 'url'"/>
                            <field name="type_display_attrs" invisible="1"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
