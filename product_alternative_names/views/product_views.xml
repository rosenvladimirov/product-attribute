<?xml version="1.0"?>
<odoo>

    <record id="product_variant_easy_edit_view" model="ir.ui.view">
        <field name="name">product.product.view.form.specifications.easy</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[3]" position="after">
                <group string="Specifications">
                    <field colspan="2" name="alt_name" nolabel="1" placeholder="Specification for this product..."/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
