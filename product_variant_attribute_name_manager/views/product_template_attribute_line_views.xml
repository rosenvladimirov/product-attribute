<odoo>
    <record id="product_template_attribute_line_form_view" model="ir.ui.view">
        <field name="name">product.template.attribute.line.form.inherit</field>
        <field name="model">product.template.attribute.line</field>
        <field name="inherit_id" ref="product.product_template_attribute_line_form" />
        <field name="arch" type="xml">
            <field name="attribute_id" position="after">
                <field name="sequence" />
                <field name="display_attribute_name" />
                <field name="display_attribute_values" />
            </field>
        </field>
    </record>

    <record id="product_template_form_view_attribute_line_tree" model="ir.ui.view">
        <field name="name">product.template.form.attribute.line.tree.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='variants']//field[@name='attribute_line_ids']/list" position="attributes">
                <attribute name="decoration-muted">not display_attribute_values</attribute>
            </xpath>
            <xpath expr="//page[@name='variants']//field[@name='attribute_line_ids']/list/field[@name='attribute_id']" position="after">
                <field name="display_attribute_name" optional="show" />
                <field name="display_attribute_values" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
