<odoo>
    <record id="product_attribute_view_form" model="ir.ui.view">
        <field name="name">product.attribute.form.inherit</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="short_name" />
            </field>
        </field>
    </record>

    <record id="product_attribute_value_view_list" model="ir.ui.view">
        <field name="name">product.attribute.value.list.inherit</field>
        <field name="model">product.attribute.value</field>
        <field name="inherit_id" ref="product.product_attribute_value_list" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="show_in_variant_name" />
            </field>
        </field>
    </record>
</odoo>
