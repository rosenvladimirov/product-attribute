<odoo>
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='variants']" position="inside">
                <group string="Variant name config">
                    <group name="variant_name_config">
                        <field name="display_variant_name_with_attributes" />
                        <field name="display_attribute_name" />
                        <field
                            name="variant_name_append_mode"
                            invisible="not display_variant_name_with_attributes"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
