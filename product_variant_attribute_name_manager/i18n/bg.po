#. module: product_variant_attribute_name_manager
#: model:ir.model.fields,field_description:product_variant_attribute_name_manager.field_product_attribute__short_name
msgid "Short Name"
msgstr "Кратко име"

#. module: product_variant_attribute_name_manager
#: model:ir.model.fields,help:product_variant_attribute_name_manager.field_product_attribute__short_name
msgid "Short name to be displayed on the product variant name. If not set, the attribute name will be used."
msgstr "Кратко име за показване в името на варианта на продукта. Ако не е зададено, ще се използва името на атрибута."

#. module: product_variant_attribute_name_manager
#: model:ir.model.fields,field_description:product_variant_attribute_name_manager.field_product_attribute_value__show_in_variant_name
msgid "Show in Variant Name"
msgstr "Показвай в име на вариант"

#. module: product_variant_attribute_name_manager
#: model:ir.model.fields,help:product_variant_attribute_name_manager.field_product_attribute_value__show_in_variant_name
msgid "If checked, the value name will be displayed in the product variant name."
msgstr "Ако е отметнато, името на стойността ще се показва в името на варианта на продукта."

#. module: product_variant_attribute_name_manager
#: model:ir.model.fields,field_description:product_variant_attribute_name_manager.field_product_template__display_variant_name_with_attributes
msgid "Display Variant Name with Attributes"
msgstr "Показвай име на вариант с атрибути"

#. module: product_variant_attribute_name_manager
#: model:ir.model.fields,help:product_variant_attribute_name_manager.field_product_template__display_variant_name_with_attributes
msgid "If checked, the variant name will include the attribute values."
msgstr "Ако е отметнато, името на варианта ще включва стойностите на атрибутите."

#. module: product_variant_attribute_name_manager
#: model:ir.model.fields,field_description:product_variant_attribute_name_manager.field_product_template__display_attribute_name
msgid "Display Attribute Name"
msgstr "Показвай име на атрибут"

#. module: product_variant_attribute_name_manager
#: model:ir.model.fields,help:product_variant_attribute_name_manager.field_product_template__display_attribute_name
msgid "If checked, the attribute name will be displayed before the attribute value in the variant name."
msgstr "Ако е отметнато, името на атрибута ще се показва преди стойността на атрибута в името на варианта."

#. module: product_variant_attribute_name_manager
#: model:ir.model.fields,field_description:product_variant_attribute_name_manager.field_product_template_attribute_line__display_attribute_name
msgid "Display Attribute Name"
msgstr "Показвай име на атрибут"

#. module: product_variant_attribute_name_manager
#: model:ir.model.fields,help:product_variant_attribute_name_manager.field_product_template_attribute_line__display_attribute_name
msgid "If checked, the attribute name will be displayed before the attribute value in the variant name."
msgstr "Ако е отметнато, името на атрибута ще се показва преди стойността на атрибута в името на варианта."

#. module: product_variant_attribute_name_manager
#: model:ir.model.fields,field_description:product_variant_attribute_name_manager.field_product_template_attribute_line__display_attribute_values
msgid "Display Attribute Values"
msgstr "Показвай стойности на атрибути"

#. module: product_variant_attribute_name_manager
#: model:ir.model.fields,help:product_variant_attribute_name_manager.field_product_template_attribute_line__display_attribute_values
msgid "If checked, the attribute values will be displayed in the variant name."
msgstr "Ако е отметнато, стойностите на атрибутите ще се показват в името на варианта."

#. module: product_variant_attribute_name_manager
#: model:ir.model.fields,field_description:product_variant_attribute_name_manager.field_product_template_attribute_line__sequence
msgid "Sequence"
msgstr "Последователност"

#. module: product_variant_attribute_name_manager
#: model:ir.model.fields,help:product_variant_attribute_name_manager.field_product_template_attribute_line__sequence
msgid "Determines the order of the attributes in the variant name."
msgstr "Определя реда на атрибутите в името на варианта."

#. module: product_variant_attribute_name_manager
#: model:ir.model,name:product_variant_attribute_name_manager.model_product_attribute
msgid "Product Attribute"
msgstr "Атрибут на продукт"

#. module: product_variant_attribute_name_manager
#: model:ir.model,name:product_variant_attribute_name_manager.model_product_attribute_value
msgid "Product Attribute Value"
msgstr "Стойност на атрибут на продукт"

#. module: product_variant_attribute_name_manager
#: model:ir.model,name:product_variant_attribute_name_manager.model_product_product
msgid "Product"
msgstr "Продукт"

#. module: product_variant_attribute_name_manager
#: model:ir.model,name:product_variant_attribute_name_manager.model_product_template
msgid "Product Template"
msgstr "Шаблон на продукт"

#. module: product_variant_attribute_name_manager
#: model:ir.model,name:product_variant_attribute_name_manager.model_product_template_attribute_line
msgid "Product Template Attribute Line"
msgstr "Линия на атрибут на шаблон на продукт"

#. module: product_variant_attribute_name_manager
#: model:ir.model,name:product_variant_attribute_name_manager.model_product_template_attribute_value
