<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_set_list" model="ir.ui.view">
        <field name="name">product.set.list</field>
        <field name="model">product.set</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name"/>
                <field name="partner_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>
    <record id="view_product_set_form" model="ir.ui.view">
        <field name="name">product.set.form</field>
        <field name="model">product.set</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Product set">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                               name="synchronize_prices"
                               icon="fa-list-ul"
                               type="object">
                               <div class="o_field_widget o_stat_info">
                                   <span>Price lists</span>
                                    <span class="o_stat_value">
                                        <field name="pricelist_count"/>
                                    </span>
                               </div>
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <field name="active" invisible="1" />
                    <field name="has_active_pricelist" invisible="1"/>
                    <field name="show_update_pricelist" invisible="1"/>
                    <field name="id" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title mb24">
                        <label for="name" string="Product Set Name"/>
                        <h1>
                            <field class="text-break" name="name" default_focus="1" placeholder="e.g. Kid's burger menu"/>
                        </h1>
                    </div>
                    <group name="main">
                        <group name="name">
                            <field name="ref"/>
                            <field name="categ_id"/>
                            <field name="amount_untaxed"/>
                        </group>
                        <group name="partner">
                            <field name="partner_id" />
                            <label for="pricelist_id"
                                   invisible="not has_active_pricelist"
                                   domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                            />
                            <div class="o_row" invisible="not has_active_pricelist">
                                <field name="pricelist_id" options="{'no_open':True,'no_create': True}" readonly="0"
                                       invisible="not has_active_pricelist and company_id == company_id"/>
                                <button name="action_update_prices" type="object"
                                    string=" Update Prices"
                                    help="Recompute all prices based on this pricelist"
                                    class="btn-link mb-1 px-0" icon="fa-refresh"
                                    confirm="This will update the unit price of all products based on the new pricelist."
                                    invisible="not show_update_pricelist"/>
                            </div>
                            <field name="price_list"/>
                            <field name="currency_id"/>
                            <field name="company_id"/>
                        </group>
                        <label for="set_line_ids" />
                        <field
                            name="set_line_ids"
                            nolabel="1"
                            widget="section_and_note_one2many"
                            context="{'default_product_set_id': id}"
                        >
                            <list editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="product_set_id" invisible="1"/>
                                <field name="pricelist_item_id" invisible="1"/>
                                <field name="compute_price" invisible="1"/>
                                <field name="show_update_pricelist" invisible="1"/>
                                <field name="product_choice" invisible="1"/>
                                <field name="product_tmpl_id"
                                       options="{'no_create': True}"/>
                                <field
                                    name="product_id"
                                    domain="product_choice"
                                    required="not display_type"
                                    options="{'no_open':True,'no_create': True}"
                                />
                                <field name="quantity"/>
                                <field name="fixed_price"
                                       readonly="not show_update_pricelist"
                                />
                                <field name="currency_id" readonly="1"/>
                                <field name="applied_on"/>
                                <field name="price_subtotal"/>
                                <field name="display_type" invisible="1" />
                                <field name="name" widget="section_and_note_text" />
                                <control>
                                    <create
                                        name="add_line_control"
                                        string="Add a line"
                                    />
                                    <create
                                        name="add_section_control"
                                        string="Add a section"
                                        context="{'default_display_type': 'line_section'}"
                                    />
                                    <create
                                        name="add_note_control"
                                        string="Add a note"
                                        context="{'default_display_type': 'line_note'}"
                                    />
                                </control>
                            </list>
                        </field>
                        <label for="set_pricelist_ids"/>
                        <field name="set_pricelist_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="product_set_id" invisible="1"/>
                                <field name="company_id" invisible="0"/>
                                <field name="pricelist_id" options="{'no_open':True,'no_create': True}"/>
                                <field name="amount_untaxed"/>
                                <field name="currency_id"/>
                                <button name="action_set_price_list"
                                        type="object"
                                        icon="fa-save"
                                        title="Set price list for all products in the set"
                                />
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_product_set_search" model="ir.ui.view">
        <field name="name">product.set.search</field>
        <field name="model">product.set</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="Product set">
                <field name="name" string="Set name"
                    filter_domain="['|', ('name', 'like', self), ('ref', 'ilike', self)]"/>
                <field
                    name="categ_id"
                    filter_domain="[('categ_id', 'child_of', raw_value)]"/>
                <filter
                    name="active"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <field name="ref"/>
                <field name="partner_id" />
                <filter
                    name="group_by_partner_id"
                    string="Partner"
                    domain="[]"
                    context="{'group_by':'partner_id'}"
                />
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="act_open_product_set_view">
        <field name="name">Product set</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.set</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_product_set_search" />
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new product set
            </p>
        </field>
    </record>
    <record model="ir.actions.act_window.view" id="act_open_product_set_view_form">
        <field name="act_window_id" ref="act_open_product_set_view" />
        <field name="sequence" eval="20" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_product_set_form" />
    </record>
    <record model="ir.actions.act_window.view" id="act_open_product_set_view_list">
        <field name="act_window_id" ref="act_open_product_set_view" />
        <field name="sequence" eval="10" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_product_set_list" />
    </record>
</odoo>
