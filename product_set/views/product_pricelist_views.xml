<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_pricelist_view" model="ir.ui.view">
        <field name="name">product.pricelist.form</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree[@groups='!product.group_sale_pricelist']/field[@name='product_id']" position="after">
                <field name="product_set_id" options="{'no_create':1}"/>
                <field name="product_set_line_id" invisible="1"/>
            </xpath>
            <xpath expr="//tree[@groups='product.group_sale_pricelist']/field[@name='product_tmpl_id']" position="after">
                <field name="product_set_id" options="{'no_create':1}"/>
                <field name="product_set_line_id" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
