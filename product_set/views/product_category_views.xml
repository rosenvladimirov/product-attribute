<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_category_form_view" model="ir.ui.view">
        <field name="name">product.category.form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                    name="%(act_open_product_set_view)d"
                    icon="fa-cubes"
                    type="action"
                    context="{'search_default_categ_id': active_id, 'default_categ_id': active_id, 'group_expand': True}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="product_set_count"/></span>
                        <span class="o_stat_text"> Product sets</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
