<?xml version="1.0"?>
<odoo>

    <record model="ir.ui.view" id="product_template_only_form_gmdn_view">
        <field name="name">product.template.form.gmdn.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="specifications"/>
            </xpath>
        </field>
    </record>
    <record id="specification_product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.product.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Specification" multi_edit="1" sample="1">
                <field name="default_code"/>
                <field name="display_name"/>
                <field name="specifications"/>
                <field name="list_price"/>
            </list>
        </field>
    </record>
    <record id="specification_product_template_search_view" model="ir.ui.view">
        <field name="name">specifications.product.template.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="Specification">
                <field name="specifications" filter_domain="[('specifications', 'like', raw_value)]"/>
                <filter name="is_specifications" string="Available Specifications" domain="[('specifications','!=',False)]"/>
            </search>
        </field>
    </record>
    <record id="specification_product_template_action" model="ir.actions.act_window">
        <field name="name">Product Specification</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="specification_product_template_tree_view"/>
        <field name="search_view_id" ref="specification_product_template_search_view"/>
        <field name="context">{'search_default_is_specifications': 1}</field>
    </record>
</odoo>
