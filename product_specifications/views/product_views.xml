<?xml version="1.0"?>
<odoo>

    <record id="product_variant_easy_edit_specifications_view" model="ir.ui.view">
        <field name="name">product.product.view.form.specifications.easy</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="specifications"/>
            </field>
        </field>
    </record>
    <record id="product_normal_form_specifications_view" model="ir.ui.view">
        <field name="name">product.product.form.specifications</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="specifications"/>
            </field>
        </field>
    </record>
    <record id="specification_product_product_tree_view" model="ir.ui.view">
        <field name="name">product.product.tree.specifications</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Specification" multi_edit="1" sample="1">
                <field name="default_code"/>
                <field name="display_name"/>
                <field name="specifications"/>
                <field name="lst_price"/>
            </list>
        </field>
    </record>
    <record id="specification_product_product_search_view" model="ir.ui.view">
        <field name="name">specifications.product.product.search</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <search string="Specification">
                <field name="specifications" filter_domain="[('specifications', 'like', raw_value)]"/>
                <filter name="is_specifications" string="Available Specifications" domain="[('specifications','!=',False)]"/>
            </search>
        </field>
    </record>
    <record id="specification_product_product_action" model="ir.actions.act_window">
        <field name="name">Product Specification</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="specification_product_product_tree_view"/>
        <field name="search_view_id" ref="specification_product_product_search_view"/>
        <field name="context">{'search_default_is_specifications': 1}</field>
    </record>
</odoo>
