<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale']" position="before">
                <field name="pricelist_item_ids"
                       nolabel="1"
                       readonly="0"
                       context="{'default_product_tmpl_id': id, 'default_applied_on': '1_product', 'default_compute_price': 'fixed', 'default_product_id': False, 'default_categ_id': False}">
                    <list editable="bottom">
                        <field name="applied_on" invisible="1"/>
                        <field name="compute_price" invisible="1"/>
                        <field name="product_tmpl_id" invisible="1"/>
                        <field name="pricelist_id"/>
                        <field name="fixed_price"/>
                        <field name="date_start" optional="hide"/>
                        <field name="date_end" optional="hide"/>
                        <field name="min_quantity" optional="hide"/>
                        <field name="currency_id" readonly="1" optional="hide"/>
                        <field name="company_id" readonly="1" optional="hide"/>
                    </list>
                </field>
                <separator string="Price list for variants" name="price_list_variants"/>
                <field name="variant_pricelist_item_ids"
                       nolabel="1"
                       readonly="0"
                       context="{'default_applied_on': '0_product_variant', 'default_compute_price': 'fixed', 'default_categ_id': False, 'default_product_tmpl_id': False}">
                    <list editable="bottom">
                        <field name="applied_on" invisible="1"/>
                        <field name="compute_price" invisible="1"/>
                        <field name="product_id" domain="[('product_tmpl_id', '=', id)]"/>
                        <field name="pricelist_id"/>
                        <field name="fixed_price"/>
                        <field name="date_start" optional="hide"/>
                        <field name="date_end" optional="hide"/>
                        <field name="min_quantity" optional="hide"/>
                        <field name="currency_id" readonly="1" optional="hide"/>
                        <field name="company_id" readonly="1" optional="hide"/>
                    </list>
                </field>
                <separator string="Price list for category" name="price_list_variants"/>
                <field name="category_pricelist_item_ids"
                       nolabel="1"
                       readonly="not category_pricelist_item_ids"
                       context="{'default_categ_id': categ_id, 'default_applied_on': '2_product_category', 'default_compute_price': 'fixed', 'default_product_id': False, 'default_product_tmpl_id': False}">
                    <list editable="bottom">
                        <field name="applied_on" invisible="1"/>
                        <field name="compute_price" invisible="1"/>
                        <field name="categ_id" invisible="1"/>
                        <field name="pricelist_id"/>
                        <field name="fixed_price"/>
                        <field name="date_start" optional="hide"/>
                        <field name="date_end" optional="hide"/>
                        <field name="min_quantity" optional="hide"/>
                        <field name="currency_id" readonly="1" optional="hide"/>
                        <field name="company_id" readonly="1" optional="hide"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
    <record id="product_variant_easy_edit_view" model="ir.ui.view">
        <field name="name">product.product.view.form.properties.easy</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="pricelist_item_ids"
                       nolabel="1"
                       readonly="0"
                       widget="one2many"
                       context="{'default_applied_on': '0_product_variant', 'default_compute_price': 'fixed', 'default_categ_id': False, 'default_product_tmpl_id': False}">
                    <list editable="bottom">
                        <field name="applied_on" invisible="1"/>
                        <field name="compute_price" invisible="1"/>
                        <field name="product_id" invisible="1"/>
                        <field name="pricelist_id"/>
                        <field name="fixed_price"/>
                        <field name="date_start" optional="hide"/>
                        <field name="date_end" optional="hide"/>
                        <field name="min_quantity" optional="hide"/>
                        <field name="currency_id" readonly="1" optional="hide"/>
                        <field name="company_id" readonly="1" optional="hide"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
