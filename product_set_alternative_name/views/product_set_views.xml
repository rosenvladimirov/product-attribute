<?xml version="1.0"?>
<odoo>
    <record id="view_product_set_form" model="ir.ui.view">
        <field name="name">product.set.form.specifications</field>
        <field name="model">product.set</field>
        <field name="inherit_id" ref="product_set.view_product_set_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='set_line_ids']" position="before">
                <group colspan="4">
                    <label for="alt_name" col="1"/>
                    <field col="3" name="alt_name" nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
